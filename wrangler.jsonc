{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neluun-v9-preview",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-23",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "neluun-v9", "database_id": "REPLACE_WITH_NEW_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "vars": {
    "AI_ENABLED": "false",
    "AI_MODEL": "gpt-4.1-mini"
  }
}
